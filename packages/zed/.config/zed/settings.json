{
    // Appearance
    "file_finder": {
        "include_ignored": "smart",
    },
    "icon_theme": "Symbols Icon Theme",
    "theme": "Aura Dark (Soft Text)",
    "ui_font_family": "Berkeley Mono",
    "buffer_font_family": "Berkeley Mono",
    "show_whitespaces": "trailing",

    // Editor
    "tab_size": 4,
    "soft_wrap": "editor_width",
    "diff_view_style": "unified",
    "format_on_save": "on",

    // Terminal
    "terminal": {
        "font_family": "Berkeley Mono",
        "font_fallbacks": ["FiraCode Nerd Font Mono"],
    },

    // Panels & Layout
    "cli_default_open_behavior": "new_window",
    "project_panel": {
        "entry_spacing": "comfortable",
        "hide_gitignore": false,
        "dock": "left",
    },
    "git_panel": {
        "status_style": "icon",
        "dock": "left",
    },
    "debugger": {
        "dock": "bottom",
    },
    "collaboration_panel": {
        "button": false,
    },

    // Extensions
    "auto_install_extensions": {
        "aura-theme": true,
        "catppuccin": true,
        "emmet": true,
        "fish": true,
        "html": true,
        "make": true,
        "oxc": true,
        "php": true,
        "scss": true,
        "symbols": true,
        "toml": true,
    },

    // Language overrides
    "languages": {
        "TypeScript": {
            "prettier": {
                "allowed": false,
            },
            "code_actions_on_format": {
                "source.removeUnusedImports": true,
            },
            "formatter": {
                "external": {
                    "command": "pnpm",
                    "arguments": [
                        "exec",
                        "oxfmt",
                        "--stdin-filepath",
                        "{buffer_path}",
                    ],
                },
            },
        },
        "TSX": {
            "prettier": {
                "allowed": false,
            },
            "code_actions_on_format": {
                "source.removeUnusedImports": true,
            },
            "formatter": {
                "external": {
                    "command": "pnpm",
                    "arguments": [
                        "exec",
                        "oxfmt",
                        "--stdin-filepath",
                        "{buffer_path}",
                    ],
                },
            },
        },
        "JavaScript": {
            "prettier": {
                "allowed": false,
            },
            "code_actions_on_format": {
                "source.removeUnusedImports": true,
            },
            "formatter": {
                "external": {
                    "command": "pnpm",
                    "arguments": [
                        "exec",
                        "oxfmt",
                        "--stdin-filepath",
                        "{buffer_path}",
                    ],
                },
            },
        },
        "JSX": {
            "prettier": {
                "allowed": false,
            },
            "code_actions_on_format": {
                "source.removeUnusedImports": true,
            },
            "formatter": {
                "external": {
                    "command": "pnpm",
                    "arguments": [
                        "exec",
                        "oxfmt",
                        "--stdin-filepath",
                        "{buffer_path}",
                    ],
                },
            },
        },
        "Astro": {
            "formatter": {
                "external": {
                    "command": "pnpm",
                    "arguments": [
                        "exec",
                        "oxfmt",
                        "--stdin-filepath",
                        "{buffer_path}",
                    ],
                },
            },
        },
        "Make": {
            "hard_tabs": true,
        },
        "YAML": {
            "tab_size": 2,
        },
    },

    // LSP
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always",
                    },
                    "preferences": {
                        "importModuleSpecifier": "project-relative",
                    },
                },
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always",
                    },
                    "preferences": {
                        "importModuleSpecifier": "project-relative",
                    },
                },
            },
            "enable_lsp_tasks": true,
        },
    },

    // AI & Agent
    "agent_servers": {
        "pi-acp": {
            "default_config_options": {
                "model": "proton-lumo/lumo-preview",
                "thought_level": "medium",
            },
            "type": "registry",
        },
        "claude-acp": {
            "default_config_options": {
                "model": "default",
                "mode": "acceptEdits",
                "effort": "medium",
            },
            "type": "registry",
        },
    },
    "agent": {
        "threads_sidebar": {
            "position": "right",
        },
        "default_model": {
            "effort": "medium",
            "provider": "zed.dev",
            "model": "claude-opus-5-5",
            "enable_thinking": true,
        },
        "button": true,
        "dock": "right",
        "single_file_review": false,
        "tool_permissions": {
            "default": "allow",
        },
        "default_profile": "write",
    },
    "edit_predictions": {
        "mode": "eager",
        "open_ai_compatible_api": {
            "prompt_format": null,
            "model": "lumo-lite",
            "api_url": "https://lumo.proton.me/api/ai/v1",
        },
        "allow_data_collection": "no",
        "provider": "zed",
    },
    "language_models": {
        "openai_compatible": {
            "Lumo": {
                "api_url": "https://lumo.proton.me/api/ai/v1",
                "available_models": [
                    {
                        "name": "lumo-lite",
                        "max_tokens": 256000,
                        "max_output_tokens": 32000,
                        "max_completion_tokens": 256000,
                        "capabilities": {
                            "tools": true,
                            "images": true,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false,
                            "chat_completions": true,
                            "interleaved_reasoning": false,
                            "max_tokens_parameter": false,
                        },
                    },
                    {
                        "name": "lumo-max",
                        "max_tokens": 256000,
                        "max_output_tokens": 32000,
                        "max_completion_tokens": 256000,
                        "capabilities": {
                            "tools": true,
                            "images": true,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false,
                            "chat_completions": true,
                            "interleaved_reasoning": false,
                            "max_tokens_parameter": false,
                        },
                    },
                    {
                        "name": "lumo-preview",
                        "max_tokens": 512000,
                        "max_output_tokens": 32000,
                        "max_completion_tokens": 512000,
                        "capabilities": {
                            "tools": true,
                            "images": true,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false,
                            "chat_completions": true,
                            "interleaved_reasoning": false,
                            "max_tokens_parameter": false,
                        },
                    },
                ],
            },
        },
    },
}
