[user]
	name = Flavien Bonvin
	email = flavien.bonvin@pm.me
	signingkey = /Users/fbonvin/.ssh/github.pub

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = /Users/fbonvin/.ssh/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
