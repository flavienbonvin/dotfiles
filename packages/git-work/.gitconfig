[user]
	name = Flavien Bonvin
	email = flavien.bonvin@proton.ch
	signingkey = /Users/fbonvin/.ssh/gitlab.pub

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = /Users/fbonvin/.ssh/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[alias]
	gsm = git switch main && git pull && git fetch --all && gclean

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
